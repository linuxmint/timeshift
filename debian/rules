#!/usr/bin/make -f
# -*- makefile -*-
# Sample debian/rules that uses debhelper.
# This file was originally written by Joey Hess and Craig Small.
# As a special exception, when this file is copied by dh-make into a
# dh-make output file, you may use that output file without restriction.
# This special exception was added by Craig Small in version 0.37 of dh-make.

# Uncomment this to turn on verbose mode.
#export DH_VERBOSE=1

override_dh_usrlocal:

# The Go compiler emits DWARF in compressed sections, which dwz(1) cannot read.
# It does not skip the file -- it fails, and takes the whole build down with it
# (Debian #931891).
#
# Two exclusions, because the Go binaries now live in two places: timeshiftd in
# /usr/libexec/timeshift, and the CLI as /usr/bin/timeshift.
#
# dh_dwz matches -X as a SUBSTRING of the path, with no way to anchor it. So
# -Xusr/bin/timeshift also excludes usr/bin/timeshift-gtk and
# usr/bin/timeshift-recovery-shell, which are Vala and compress fine. That is a
# deliberate trade: the cost is uncompressed DWARF for two binaries, and the
# alternative -- leaving the CLI in /usr/libexec and symlinking it into
# /usr/bin -- would put a program users type at a path Policy reserves for ones
# they do not.
override_dh_dwz:
	dh_dwz -Xusr/libexec/timeshift/ -Xusr/bin/timeshift

%:
	dh $@
