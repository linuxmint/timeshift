# apt-snapshot-guard configuration (sourced as /bin/sh).
# Controls the DPkg::Pre-Invoke hook in /etc/apt/apt.conf.d/05snapshot-guard.
#
# Policy is fail-CLOSED: apt does not change packages without a snapshot.
# If the snapshot fails, you are prompted on a terminal (default No aborts);
# with no terminal (GUI Software Updater, PackageKit, unattended-upgrades) the
# operation is aborted. To proceed without a snapshot for a single run, set the
# one-shot bypass flag first:
#
#   sudo touch /run/apt-snapshot-guard.bypass
#   sudo apt install <pkg>        # snapshot skipped once; flag auto-removed
#
# The environment variable APT_SNAPSHOT_GUARD=off (also: 0, no) disables the
# guard for that one invocation, e.g.:
#
#   sudo APT_SNAPSHOT_GUARD=off apt install <pkg>
#
# Both bypasses exist for deliberate use; anything that can set them already
# has root, so they widen no privilege.

# Master switch. 0 disables the guard entirely (apt runs with no snapshot).
ENABLED=1

# Collapse repeated dpkg invocations within one transaction into a single
# snapshot: skip if a guard snapshot was taken this many seconds ago.
WINDOW=90

# Hard cap (seconds) on the timeshift --create call.
TIMEOUT=900

# Seconds to wait for an answer at the interactive (terminal) failure prompt.
# No answer within this window is treated as "No" and aborts the operation.
PROMPT_TIMEOUT=60

# Graphical bypass for interactive GUI updates (Software Updater / PackageKit)
# when the snapshot fails and there is no terminal to prompt on.
#   1 = show a zenity dialog to the desktop user (Continue anyway / Cancel).
#   0 = no dialog; a failed snapshot aborts the GUI update too.
# unattended-upgrades never shows a dialog regardless of this setting.
GUI_PROMPT=1

# Seconds to wait for an answer at the graphical dialog. No answer aborts.
# 0 = wait indefinitely (only safe if someone is at the machine).
GUI_PROMPT_TIMEOUT=120

# Timeshift tag applied to guard snapshots (O = on-demand).
TAGS=O

# Drive the snapshot through timeshiftd when it is listening (1) or always use
# the `timeshift` on PATH (0).
#
# The daemon path makes an apt-driven snapshot watchable: `timeshift --watch`,
# or the GUI, can attach to it while apt waits here. Set this to 0 to pin the
# old behaviour, in which the snapshot runs as a private process that nothing
# else can see into.
#USE_DAEMON=1

# --- environment-only overrides ---------------------------------------------
#
# Not settings so much as test hooks; both have sensible defaults and neither
# normally needs changing.
#
#   TS_CLIENT   the daemon client to run    (default /usr/libexec/timeshift/timeshift)
#   TS_SOCKET   the daemon socket to use    (default /run/timeshift/daemon.sock)
#
# Setting TS_CLIENT to a stub and USE_DAEMON=0 is how the fallback path can be
# exercised without a daemon.

# --- a note on 0 --------------------------------------------------------------
#
# 0 does NOT mean the same thing to every knob above, so it is spelled out:
#
#   TIMEOUT=0             no limit on the snapshot -- but flock also gets 0,
#                         which means "fail immediately if another apt run holds
#                         the lock". Not recommended; this hook blocks dpkg.
#   PROMPT_TIMEOUT=0      the terminal prompt returns instantly with no input,
#                         which counts as "no" -- so it ABORTS immediately.
#   GUI_PROMPT_TIMEOUT=0  the dialog waits indefinitely, bounded only by the
#                         hook's own outer cap of 300s.
