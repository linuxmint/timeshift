#!/bin/sh
# Handle the dpkg trigger fired when Timeshift itself changes.
#
# This runs inside a dpkg transaction, so it must stay cheap and must NOT
# provision: building an environment runs apt in a chroot and downloads
# hundreds of megabytes. Mark the environment stale and hand off to a systemd
# unit, which takes the dpkg lock and so waits for the current apt run to
# finish rather than racing it.
set -e

STATE_DIR=/var/lib/timeshift-recovery

case "$1" in
	triggered)
		# Only meaningful once an environment has actually been installed.
		if [ -f "$STATE_DIR/installed" ]; then
			date -Is > "$STATE_DIR/stale" 2>/dev/null || : > "$STATE_DIR/stale"

			# --no-block: never hold up the dpkg transaction. The unit itself
			# blocks on the dpkg lock before doing any work.
			if [ -d /run/systemd/system ]; then
				systemctl start --no-block timeshift-recovery-refresh.service \
					>/dev/null 2>&1 || true
			fi
		fi
		;;

	configure)
		# Artifacts built by an older version were left world-readable, and
		# they embed the SSH key, Wi-Fi passphrases and Tailscale identity.
		# Tighten quietly on upgrade; new builds create them 0600 themselves.
		for f in /var/cache/timeshift-recovery/filesystem.squashfs \
		         /var/lib/timeshift-recovery/recovery.img; do
			if [ -f "$f" ]; then chmod 0600 "$f" || true; fi
		done

		# The file trigger is NOT delivered when timeshift and this package
		# are upgraded in the same apt transaction: dpkg clears pending
		# triggers for a package it is about to configure. Catch the
		# staleness here so the refresh still happens promptly rather than
		# waiting for the boot-time run of the refresh unit.
		if [ -f "$STATE_DIR/installed" ] && [ -r /var/cache/timeshift-recovery/build-info ]; then
			built=$(. /var/cache/timeshift-recovery/build-info 2>/dev/null; printf '%s' "${TS_VERSION:-}")
			host=$(dpkg-query -W -f='${Version}' timeshift-ssh 2>/dev/null \
				|| dpkg-query -W -f='${Version}' timeshift 2>/dev/null || true)
			if [ -n "$built" ] && [ -n "$host" ] && [ "$built" != "$host" ]; then
				date -Is > "$STATE_DIR/stale" 2>/dev/null || : > "$STATE_DIR/stale"
				if [ -d /run/systemd/system ]; then
					systemctl start --no-block timeshift-recovery-refresh.service \
						>/dev/null 2>&1 || true
				fi
			fi
		fi

		# Deliberately does not provision. Building an environment needs the
		# network and several minutes, neither of which belongs in an install.
		if [ ! -f "$STATE_DIR/installed" ]; then
			echo "timeshift-recovery: run 'sudo timeshift-recovery install' to provision the recovery environment."
		fi
		;;
esac

#DEBHELPER#

exit 0
