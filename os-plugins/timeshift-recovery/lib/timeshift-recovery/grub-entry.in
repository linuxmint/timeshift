#!/bin/sh
exec tail -n +3 "$0"
# Timeshift recovery environment.
#
# Written by "timeshift-recovery install"; removed by "timeshift-recovery remove"
# and by the package's postrm. Do not edit this file -- re-run install instead.
#
# The hotkey only works while a GRUB timeout is running: GRUB reads no keyboard
# at all when GRUB_TIMEOUT is 0, which is what Ubuntu ships. The matching
# timeout lives in /etc/default/grub.d/timeshift-recovery.cfg.
# @HINT@
menuentry 'Timeshift Recovery' --hotkey=@HOTKEY@ --class recovery --id=timeshift-recovery {
	insmod part_gpt
	insmod part_msdos
	insmod ext2
	insmod fat

	search --no-floppy --fs-uuid --set=root @UUID@

	linux  @KERNEL@ @CMDLINE@
	initrd @INITRD@
}
