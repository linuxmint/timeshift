
*~
build/
dist/
# dpkg-buildpackage writes its artifacts into the PARENT of the package being
# built, so where they land depends on where the package lives:
#   debian/          (the root package)  -> $HOME, collected by build-all.sh
#   os-plugins/*/                        -> os-plugins/
#   src-recovery/                        -> the repo root
# Hence both the repo root and os-plugins/ need the rules; the os-plugins ones
# are belt to the braces of os-plugins/.gitignore, so a deleted subdir ignore
# cannot expose them.
*.deb
*.ddeb
*.changes
*.buildinfo
os-plugins/*.deb
os-plugins/*.ddeb
os-plugins/*.changes
os-plugins/*.buildinfo
.bzr
*.c
debian/.debhelper/
debian/debhelper-build-stamp
debian/*.debhelper.log
debian/files
debian/timeshift/
debian/timeshift.debhelper.log
debian/timeshift-ssh/
debian/timeshift-ssh.debhelper.log
debian/timeshift-ssh.substvars
debian/timeshift.substvars
debian/tmp/
designs/
*.geany
.git
*.mo
*.o
obj-*/
parts/
po-lp/
prime/
release/
release/amd64
release/armel
release/armhf
release/*.deb
release/i386
release/*.run
release/source
rpm/
snap/
src/timeshift
src/timeshift.1
src/timeshift-gtk
stage/
debian/*.debhelper
