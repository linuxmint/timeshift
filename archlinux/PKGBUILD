# Maintainer:  Tony George teejeetech at gmail dot com

set -u

rm -rf *.pkg.tar*

if ! [ -d src ]; then
rsync -avh --delete --exclude=.git --exclude=archlinux --exclude=debian --exclude=release ../ src/
fi

pkgname='timeshift-ssh'
pkgver="$(cd .. && dpkg-parsechangelog --show-field Version)"
pkgrel='1'
pkgdesc='System restore tool for Linux, with remote SSH snapshot storage'
arch=('i686' 'x86_64' 'armv7h' 'aarch64')
license=('GPL-2.0-or-later')

# required for build and run
depends=('libgee>=0.18.0' 'gtk4>=4.12' 'json-glib' 'desktop-file-utils' 'vte4' 'rsync'
         'openssh' 'glib2' 'polkit' 'libnotify' 'xdg-utils')
optdepends=('sshfs: browse snapshots stored on a remote host'
            'cryptsetup: unlock LUKS-encrypted snapshot devices'
            'btrfs-progs: BTRFS snapshot mode')

# required for build
# dpkg is needed to parse version string
makedepends=('vala' 'meson' 'ninja' 'help2man' 'gettext' 'dpkg' 'diffutils' 'coreutils') 

optdepends=(
  'cronie: scheduling'
)

_srcdir=./
source=()

prepare() {
  set -u
  cd "${_srcdir}"
  set +u
}

build() {
  set -u
  # meson only -- there is no Makefile in this tree
  meson setup --prefix=/usr "${_srcdir}/build" "${_srcdir}"
  meson compile -C "${_srcdir}/build"
  set +u
}

package() {
  set -u
  DESTDIR="${pkgdir}" meson install -C "${_srcdir}/build"
  set +u
}

set +u

